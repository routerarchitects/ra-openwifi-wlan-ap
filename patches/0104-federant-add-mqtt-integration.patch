diff --git a/files/etc/config/federant_mqtt b/files/etc/config/federant_mqtt
new file mode 100644
index 0000000000..f250f29eee
--- /dev/null
+++ b/files/etc/config/federant_mqtt
@@ -0,0 +1,12 @@
+config mqttpipe 'config'
+	option enabled 1
+	option mqtt_url 'mqtt://localhost'
+	option mqtt_port 1883
+
+config mqttpipe 'dhcp'
+
+config mqttpipe 'ucentral'
+        option summary 'uCentral Operational Data'
+        option topic '/'
+        list 'parameter' 'UCENTRAL_FEED'
+
diff --git a/files/etc/init.d/federant_mqtt b/files/etc/init.d/federant_mqtt
new file mode 100755
index 0000000000..919be4b1aa
--- /dev/null
+++ b/files/etc/init.d/federant_mqtt
@@ -0,0 +1,22 @@
+#!/bin/sh /etc/rc.common
+
+START=99
+USE_PROCD=1
+
+start_service() {
+        # Task 1: /UCENTRAL_FEED -> ucentral health
+        procd_open_instance ucentral
+        procd_set_param command /usr/share/ucentral/federant_mqtt.sh
+        procd_set_param respawn 5 60 10
+        procd_set_param stdout 1
+        procd_set_param stderr 1
+        procd_close_instance
+
+        # Task 2: DHCP lease changes -> /dhcp/notification
+        procd_open_instance dhcp
+        procd_set_param command /usr/share/ucentral/federant_mqtt_dhcp.sh
+        procd_set_param respawn 5 60 10
+        procd_set_param stdout 1
+        procd_set_param stderr 1
+        procd_close_instance
+}
