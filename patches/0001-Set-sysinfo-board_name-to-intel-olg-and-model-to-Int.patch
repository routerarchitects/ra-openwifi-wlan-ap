From d152c41cbbdb788cbca8f5cefa1d6b196aeffed5 Mon Sep 17 00:00:00 2001
From: Aditya-Rai-25 <aditya21.rai@routerarchitects.com>
Date: Mon, 23 Feb 2026 18:55:19 +0530
Subject: [PATCH] Set sysinfo board_name to intel-olg and model to Intel

---
 target/linux/x86/base-files/lib/preinit/01_sysinfo | 5 ++---
 target/linux/x86/image/Makefile                    | 2 +-
 2 files changed, 3 insertions(+), 4 deletions(-)

diff --git a/target/linux/x86/base-files/lib/preinit/01_sysinfo b/target/linux/x86/base-files/lib/preinit/01_sysinfo
index 0714a9a39f..3a54255130 100644
--- a/target/linux/x86/base-files/lib/preinit/01_sysinfo
+++ b/target/linux/x86/base-files/lib/preinit/01_sysinfo
@@ -57,9 +57,8 @@ do_sysinfo_x86() {
 
 	mkdir -p /tmp/sysinfo
 
-	echo "$vendor $product" > /tmp/sysinfo/model
-
-	sanitize_name_x86 /tmp/sysinfo/model > /tmp/sysinfo/board_name
+	echo "Intel" > /tmp/sysinfo/model
+	echo "intel-olg" > /tmp/sysinfo/board_name
 }
 
 boot_hook_add preinit_main do_sysinfo_x86
diff --git a/target/linux/x86/image/Makefile b/target/linux/x86/image/Makefile
index 322131c2a4..931c1f52de 100644
--- a/target/linux/x86/image/Makefile
+++ b/target/linux/x86/image/Makefile
@@ -148,7 +148,7 @@ define Device/Default
   endif
   IMAGES := $$(IMAGES-y)
   ARTIFACTS := $$(ARTIFACTS-y)
-  SUPPORTED_DEVICES :=
+  SUPPORTED_DEVICES := intel-olg
 endef
 
 include $(SUBTARGET).mk
-- 
2.34.1

